{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Service Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service_type", "quality", "scale", "priority", "duration_minutes", "execution_mode"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "service_type": {"enum": ["live_video", "interactive_control", "massive_sensor"]},
    "quality": {"enum": ["standard", "high", "critical"]},
    "scale": {"type": "integer", "minimum": 1},
    "priority": {"enum": ["normal", "high", "critical"]},
    "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
    "execution_mode": {"enum": ["dry_run", "execute"]}
  }
}
