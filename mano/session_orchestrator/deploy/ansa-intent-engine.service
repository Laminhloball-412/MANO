[Unit]
Description=ANSA asynchronous application intent engine
After=network-online.target ansa-session-metrics.service
Requires=ansa-session-metrics.service

[Service]
Type=simple
User=ubuntu
StateDirectory=ansa-session-orchestrator
StateDirectoryMode=0750
WorkingDirectory=/home/ubuntu/mano
ExecStart=/usr/bin/python3 -m session_orchestrator.cli --config /home/ubuntu/mano/session_orchestrator/config.json intentd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
