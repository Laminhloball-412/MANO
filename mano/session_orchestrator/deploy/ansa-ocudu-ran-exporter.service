[Unit]
Description=ANSA OCUDU RAN metrics exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mano
ExecStart=/home/ubuntu/mano/runtime/ran-exporter-venv/bin/python3 -m session_orchestrator.ran_exporter --config /home/ubuntu/mano/session_orchestrator/ran-exporter.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
