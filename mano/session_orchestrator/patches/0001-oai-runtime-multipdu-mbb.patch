+static void generatePduSessionReleaseMessage(nr_ue_nas_t *nas,
+                                             as_nas_info_t *initialNasMsg,
+                                             const pdu_session_config_t *pdu,
+                                             uint8_t message_type)
+{
+  DevAssert(message_type == FGS_PDU_SESSION_RELEASE_REQ || message_type == FGS_PDU_SESSION_RELEASE_COMPLETE);
+  uint8_t sm_buffer[4] = {
+    FGS_SESSION_MANAGEMENT_MESSAGE,
+    pdu->id,
+    1, /* PTI */
+    message_type,
+  };
+
+  int size = 7;
+  fgmm_nas_msg_security_protected_t sp_msg = {0};
+  fgs_nas_message_security_header_t *sp_header = &sp_msg.header;
+  sp_header->protocol_discriminator = FGS_MOBILITY_MANAGEMENT_MESSAGE;
+  sp_header->security_header_type = INTEGRITY_PROTECTED_AND_CIPHERED;
+  sp_header->sequence_number = nas->security.nas_count_ul & 0xff;
+
+  fgmm_nas_message_plain_t *plain = &sp_msg.plain;
+  plain->header = set_mm_header(FGS_UPLINK_NAS_TRANSPORT, PLAIN_5GS_MSG);
+  size += sizeof(plain->header);
+
+  fgs_uplink_nas_transport_msg *mm_msg = &plain->mm_msg.uplink_nas_transport;
+  mm_msg->payloadcontainertype.iei = 0;
+  mm_msg->payloadcontainertype.type = 1;
+  size += 1;
+  mm_msg->fgspayloadcontainer.payloadcontainercontents.length = sizeof(sm_buffer);
+  mm_msg->fgspayloadcontainer.payloadcontainercontents.value = sm_buffer;
+  size += 2 + sizeof(sm_buffer);
+  mm_msg->pdusessionid = pdu->id;
+  mm_msg->requesttype = 1;
+  size += 3;
+
+  const bool has_sd = pdu->nssai.sd != 0xffffff;
+  const size_t nssai_len = has_sd ? 4 : 1;
+  mm_msg->snssai.length = nssai_len;
+  mm_msg->snssai.value = calloc_or_fail(nssai_len, 1);
+  mm_msg->snssai.value[0] = pdu->nssai.sst;
+  if (has_sd)
+    INT24_TO_BUFFER(pdu->nssai.sd, &mm_msg->snssai.value[1]);
+  size += 2 + nssai_len;
+
+  const int dnn_size = strlen(pdu->dnn);
+  mm_msg->dnn.value = calloc_or_fail(dnn_size + 1, 1);
+  mm_msg->dnn.length = dnn_size + 1;
+  mm_msg->dnn.value[0] = dnn_size;
+  memcpy(mm_msg->dnn.value + 1, pdu->dnn, dnn_size);
+  size += 2 + dnn_size + 1;
+
+  initialNasMsg->nas_data = malloc_or_fail(size);
+  const int security_header_len = nas_protected_security_header_encode(initialNasMsg->nas_data, sp_header, size);
+  initialNasMsg->length = security_header_len
+      + mm_msg_encode(plain, initialNasMsg->nas_data + security_header_len, size - security_header_len);
+  free(mm_msg->dnn.value);
+  free(mm_msg->snssai.value);
+
+  nas_stream_cipher_t cipher = {0};
+  uint8_t encrypted[initialNasMsg->length - 7];
+  cipher.context = nas->security_container->ciphering_context;
+  cipher.count = nas->security.nas_count_ul;
+  cipher.bearer = 1;
+  cipher.direction = 0;
+  cipher.message = initialNasMsg->nas_data + 7;
+  cipher.blength = (initialNasMsg->length - 7) << 3;
+  stream_compute_encrypt(nas->security_container->ciphering_algorithm, &cipher, encrypted);
+  memcpy(cipher.message, encrypted, initialNasMsg->length - 7);
+
+  uint8_t mac[NAS_INTEGRITY_SIZE] = {0};
+  cipher.context = nas->security_container->integrity_context;
+  cipher.count = nas->security.nas_count_ul++;
+  cipher.message = initialNasMsg->nas_data + 6;
+  cipher.blength = (initialNasMsg->length - 6) << 3;
+  stream_compute_integrity(nas->security_container->integrity_algorithm, &cipher, mac);
+  memcpy(initialNasMsg->nas_data + 2, mac, NAS_INTEGRITY_SIZE);
+}
