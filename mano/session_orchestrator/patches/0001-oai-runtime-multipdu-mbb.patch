+  // Legacy form uses the UICC default. Extended form selects a target slice.
+  int n = sscanf(buf, "%d,%d,%d,%x,%102s", &pdusession_id, &ue_id, &sst, &sd, dnn);
   if (n == 1) {
-    // Only PDUSessionID provided: use default UE ID
