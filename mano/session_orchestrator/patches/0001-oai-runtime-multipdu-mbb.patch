+static int release_pdu_session(char *buf, int debug, telnet_printfunc_t prnt)
+{
+  UNUSED(debug);
+  int ue_id = -1;
+  int pdusession_id = -1;
+  if (!buf)
+    ERROR_MSG_RET("Missing argument: expected PDUSessionID[,UE_ID]\n");
+
+  int n = sscanf(buf, "%d,%d", &pdusession_id, &ue_id);
+  if (n == 1) {
+    ue_id = get_default_ue_id();
+    if (ue_id < 0)
+      ERROR_MSG_RET("No default UE context found\n");
+  } else if (n != 2) {
+    ERROR_MSG_RET("Invalid format: expected PDUSessionID[,UE_ID]\n");
+  }
+  if (pdusession_id < 1 || pdusession_id > 255 || ue_id < 0)
+    ERROR_MSG_RET("PDU session ID must be 1..255 and UE ID must be non-negative\n");
+
+  nr_ue_nas_t *nas = get_ue_nas_info(ue_id);
+  if (!nas || !nas->uicc)
+    ERROR_MSG_RET("No NAS context found for UE_ID %d\n", ue_id);
+  bool found = false;
+  for (int i = 0; i < nas->uicc->n_pdu_sessions; ++i)
+    found |= nas->uicc->pdu_sessions[i].id == pdusession_id;
+  if (!found)
+    ERROR_MSG_RET("PDU session ID %d does not exist for UE %d\n", pdusession_id, ue_id);
+
+  request_pdusession_release(nas, pdusession_id);
+  prnt("Triggered PDU session release for UE %d ID %d\n", ue_id, pdusession_id);
   return 0;
 }
 
