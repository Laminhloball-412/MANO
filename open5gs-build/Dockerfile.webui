FROM node:20-slim

RUN apt-get update && apt-get install -y git && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --branch v2.7.7 --depth 1 \
        https://github.com/open5gs/open5gs.git /open5gs

WORKDIR /open5gs/webui

RUN npm ci

ENV NODE_ENV=development
EXPOSE 9999

CMD ["npm", "run", "dev"]
